# Koneksi MySQL: mysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL="mysql://pos:pos_password@localhost:3306/pos_kafe"

# Ganti dengan string acak yang panjang di production
JWT_SECRET="ganti-dengan-secret-yang-panjang-dan-acak"
JWT_EXPIRES_IN="12h"

PORT=4000

# URL frontend (untuk CORS). Pisahkan dengan koma jika lebih dari satu.
FRONTEND_URL="http://localhost:3000"

# Zona waktu untuk nomor invoice dan pengelompokan laporan harian
APP_TIMEZONE="Asia/Jakarta"
